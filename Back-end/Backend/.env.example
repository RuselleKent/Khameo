# Kopyahin ito bilang ".env" para sa local. HUWAG i-commit ang .env.
# Sa Render, sa Environment tab ilalagay ang mga value na ito (hindi sa file).

APP_NAME=Khameo
APP_ENV=local
# Gumawa ng key: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

# --- Supabase (Session pooler, port 5432) ---
# Supabase > Connect > Session pooler. Gumamit ng simpleng password (letters at numbers lang).
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxxxx
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Email (Brevo) ---
# Walang BREVO_API_KEY = ang code ay nasa storage/logs/laravel.log lang (para sa local).
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Khameo

# Dito magbubukas ang link ng reset password email
FRONTEND_RESET_URL=http://localhost:8081/reset-password
GOOGLE_CLIENT_IDS=
