APP_NAME=Khameo
APP_ENV=local
APP_KEY=                          # Run 'php artisan key:generate' if this is empty
APP_DEBUG=true
APP_TIMEZONE=UTC                  # Match your config/app.php timezone

# ==============================================================================
# 📱 MOBILE DEVICE CONNECTIVITY SETTINGS
# ==============================================================================
# Change this URL depending on how you are previewing your React Native app:
# 1. iOS Simulator:        http://localhost:8000
# 2. Android Emulator:    http://10.0.2.2:8000
# 3. Physical Phone:       Use your computer's local IP (e.g., http://192.168.1.15:8000)
APP_URL=http://localhost:8000

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ==============================================================================
# 🗄️ DATABASE CONFIGURATION (Clean SQLite Setup)
# ==============================================================================
DB_CONNECTION=sqlite
# No host, ports, usernames, or passwords are required for SQLite

# ==============================================================================
# ⚙️ APPLICATION DRIVERS & CACHING (Database-driven for easy multi-device sync)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# ✉️ MAIL CONFIGURATION (Logs emails locally instead of attempting to send them)
# ==============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# ☁️ THIRD PARTY / AWS SERVICES (Keep empty unless required)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Exposes the backend name globally if needed
VITE_APP_NAME="${APP_NAME}"
